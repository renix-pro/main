# ---------------------------------------------------------------------------
# RENIX local environment. Copy to .env and fill in the secrets.
# Everything here was previously provided automatically by Replit.
# ---------------------------------------------------------------------------

# App port. NOTE: macOS uses 5000 for AirPlay Receiver and 3000 is often taken;
# 4000 is a safe default. Update the Google OAuth "Authorized JavaScript origins"
# to http://localhost:<PORT> if you change it.
PORT=4000

# PostgreSQL (docker compose up -d starts one with these credentials)
DATABASE_URL=postgresql://renix:renix@localhost:5432/renix

# Session cookie signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Object storage. Locally the app uses a GCS emulator from docker-compose.yml.
# (Named GCS_EMULATOR_URL on purpose: the Google client library treats the
# standard STORAGE_EMULATOR_HOST variable specially and breaks the URL.)
# PRIVATE_OBJECT_DIR is "/<bucket>/<prefix>"; the seeded files live under ".private".
GCS_EMULATOR_URL=http://localhost:4443
PRIVATE_OBJECT_DIR=/renix-local/.private
PUBLIC_OBJECT_SEARCH_PATHS=/renix-local/public

# OpenAI. Required for every AI feature (companion, document extraction,
# summaries, overview interpretations, quote insights, hero images).
OPENAI_API_KEY=
# Optional overrides:
# OPENAI_MODEL=gpt-4o                 # extraction + companion
# OPENAI_MODEL_FAST=gpt-4o-mini       # classification, summaries, short insights
# OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini # cost-validation web research
# OPENAI_IMAGE_MODEL=gpt-image-1      # project hero images
# OPENAI_BASE_URL=                    # only for a proxy/gateway

# Google Sign-In (Google Identity Services). Same value for both.
GOOGLE_CLIENT_ID=330504562925-iq2dn0s78vjh3d32o2jr8fkh5cd061s4.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=330504562925-iq2dn0s78vjh3d32o2jr8fkh5cd061s4.apps.googleusercontent.com

# Password-reset emails via Gmail SMTP (optional; feature is disabled if unset)
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=RENIX Support

# AI observability (optional)
# AI_MAX_TOKEN_BUDGET=
# AI_STRUCTURED_LOGS=true
# AI_TOKEN_SAFETY=true
# AI_LOG_LEVEL=info
